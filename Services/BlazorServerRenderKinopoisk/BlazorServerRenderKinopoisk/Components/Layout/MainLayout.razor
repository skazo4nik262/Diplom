@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject TokenStore TokenStore

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@if (_showAppBar)
{
    <AppBar />
}

<div class="main-content @(_showAppBar ? "" : "no-appbar")">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _showAppBar = true;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await TokenStore.LoadFromStorageAsync();
        if (TokenStore.IsAdmin)
        {
            var uri = Navigation.Uri;
            if (!uri.Contains("/admin/", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/admin/movies", replace: true);
                return;
            }
        }
        _initialized = true;
        _showAppBar = ShouldShowAppBar(Navigation.Uri);
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (!_initialized) return;
        _showAppBar = ShouldShowAppBar(Navigation.Uri);
    }

    private static bool ShouldShowAppBar(string uri)
    {
        return !uri.EndsWith("/login") && !uri.EndsWith("/login/")
            && !uri.EndsWith("/register") && !uri.EndsWith("/register/")
            && !uri.Contains("/search");
    }

    private MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#F6C516",
            Background = "#000000",
            Surface = "#0f0f0f",
        }
    };
}

@page "/profile/edit"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject TokenStore TokenStore
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using BlazorServerRenderKinopoisk.Services

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center mt-8">
    <MudCard Elevated Class="pa-8" Style="width: 100%; max-width: 500px;">
        <MudCardContent>
            <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Редактировать профиль</MudText>

            @if (_profile is null)
            {
                <MudProgressCircular Indeterminate />
            }
            else
            {
                <div class="d-flex flex-column align-center mb-6">
                    <div class="avatar-preview" style="background-image: url('@_avatarPreview'); background-size: cover; background-position: center; width: 120px; height: 120px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.15); margin-bottom: 12px; @(_avatarPreview is null ? "background-color: #333;" : "")">
                        @if (_avatarPreview is null)
                        {
                            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; opacity: 0.3;">@GetInitials()</div>
                        }
                    </div>
                    <label class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-size-medium"
                           style="cursor: pointer;">
                        Загрузить аватарку
                        <InputFile OnChange="@HandleFileSelected" accept=".jpg,.jpeg,.png,.gif,.webp" hidden />
                    </label>
                    @if (_uploadingAvatar)
                    {
                        <MudProgressCircular Indeterminate Size="Size.Small" Class="mt-2" />
                    }
                </div>

                <MudTextField @bind-Value="_username" Label="Имя пользователя" Variant="Variant.Outlined" Class="mb-4" />
                <MudTextField @bind-Value="_bio" Label="О себе" Variant="Variant.Outlined" Class="mb-4" Lines="4" />
                <MudDatePicker @bind-Date="_birthday" Label="Дата рождения" Variant="Variant.Outlined" Class="mb-6" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Disabled="@_isLoading" OnClick="@HandleSave" Size="Size.Large">
                    @(_isLoading ? "Сохранение..." : "Сохранить")
                    @if (_isLoading)
                    {
                        <MudProgressCircular Indeterminate Size="Size.Small" Class="ml-2" />
                    }
                </MudButton>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private ProfileResponse? _profile;
    private string _username = "";
    private string _bio = "";
    private DateTime? _birthday;
    private bool _isLoading;
    private string? _avatarPreview;
    private string? _newAvatarUrl;
    private bool _uploadingAvatar;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await TokenStore.LoadFromStorageAsync();
        if (!TokenStore.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _profile = await AuthService.GetProfileAsync();
        if (_profile is not null)
        {
            _username = _profile.Username ?? "";
            _bio = _profile.Bio ?? "";
            _birthday = _profile.Birthday;
            if (!string.IsNullOrEmpty(_profile.AvatarUrl))
            {
                _avatarPreview = AvatarHelper.Resolve(_profile.AvatarUrl);
            }
        }
        StateHasChanged();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
        if (!allowedExtensions.Contains(ext))
        {
            Snackbar.Add("Недопустимый формат файла. Разрешены: jpg, png, gif, webp", Severity.Error);
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            Snackbar.Add("Файл слишком большой. Максимум 5 МБ", Severity.Error);
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        _uploadingAvatar = true;
        StateHasChanged();

        try
        {
            _newAvatarUrl = await AuthService.UploadAvatarAsync(stream, file.Name);

            if (_newAvatarUrl is null)
            {
                Snackbar.Add("Ошибка загрузки аватарки", Severity.Error);
                return;
            }

            _avatarPreview = AvatarHelper.Resolve(_newAvatarUrl);
            Snackbar.Add("Аватарка загружена! Сохраните профиль", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Ошибка загрузки аватарки", Severity.Error);
        }
        finally
        {
            _uploadingAvatar = false;
            StateHasChanged();
        }
    }

    private async Task HandleSave()
    {
        _isLoading = true;

        var result = await AuthService.UpdateProfileAsync(
            string.IsNullOrWhiteSpace(_username) ? null : _username,
            string.IsNullOrWhiteSpace(_bio) ? null : _bio,
            _birthday,
            _newAvatarUrl);

        _isLoading = false;

        if (result is null)
        {
            Snackbar.Add("Ошибка сохранения профиля", Severity.Error);
            return;
        }

        _profile = result;
        Snackbar.Add("Профиль обновлён!", Severity.Success);
        Navigation.NavigateTo("/profile");
    }

    private string GetInitials()
    {
        var name = _profile?.Username ?? _profile?.Login ?? "";
        return name.Length > 0 ? name[..1].ToUpper() : "?";
    }
}

@page "/user/{UserId:guid}"
@rendermode InteractiveServer
@inject CatalogService Catalog
@inject AuthService AuthService
@inject TokenStore TokenStore
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<div class="mt-4">
    @if (_loading)
    {
        <div class="d-flex justify-center mt-16">
            <MudProgressCircular Indeterminate Size="Size.Large" />
        </div>
    }
    else if (_profile is null)
    {
        <div class="d-flex justify-center mt-16">
            <MudText Typo="Typo.h6" Style="opacity: 0.5">Пользователь не найден</MudText>
        </div>
    }
    else
    {
        <div class="user-profile-header">
            @{
                var avatarDisplayUrl = string.IsNullOrEmpty(_profile.AvatarUrl) ? "" : $"{Configuration["ApiClient:ApiUrl"]?.TrimEnd('/') ?? "http://screeny.ddns.net"}{_profile.AvatarUrl}";
            }
            <div class="user-profile-avatar" style="background-image: url('@avatarDisplayUrl')">
                @if (string.IsNullOrEmpty(_profile.AvatarUrl))
                {
                    <span>@((_profile.Username ?? _profile.Login)[..1].ToUpper())</span>
                }
            </div>
            <div>
                <div class="d-flex align-center gap-4">
                    <MudText Typo="Typo.h4">@(_profile.Username ?? _profile.Login)</MudText>
                    @if (!_isOwnProfile)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   @onclick="ToggleFollow" Disabled="_followLoading">
                            @(_followStatus?.IsFollowing == true ? "Отписаться" : "Подписаться")
                        </MudButton>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_profile.Bio))
                {
                    <MudText Typo="Typo.body2" Style="opacity: 0.7">@_profile.Bio</MudText>
                }
                <div class="user-profile-stats">
                    <span>🎬 @_profile.MovieCount фильмов</span>
                    <span>📝 @(_profile.Reviews?.Count ?? 0) отзывов</span>
                </div>
                <div class="user-profile-status-counts">
                    <span class="status-count watching">Смотрю: @_profile.WatchingCount</span>
                    <span class="status-count planned">Запланировано: @_profile.PlannedCount</span>
                    <span class="status-count watched">Просмотрено: @_profile.WatchedCount</span>
                    <span class="status-count dropped">Брошено: @_profile.DroppedCount</span>
                </div>
            </div>
        </div>

        @if (_comparison is not null && !_isOwnProfile)
        {
            <MudText Typo="Typo.h5" Class="mt-6 mb-2">Сравнение вкусов</MudText>
            <div class="taste-comparison">
                <div class="comparison-stat">
                    <span class="comparison-value">@_comparison.CommonMovies</span>
                    <span class="comparison-label">общих фильмов</span>
                </div>
                <div class="comparison-stat">
                    <span class="comparison-value">@_comparison.OverlapPercent%</span>
                    <span class="comparison-label">совпадение</span>
                </div>
                <div class="comparison-stat">
                    <span class="comparison-value">@_comparison.AverageRatingDifference</span>
                    <span class="comparison-label">разница в оценках</span>
                </div>
            </div>
        }

        @if (_profile.Reviews?.Count > 0)
        {
            <MudText Typo="Typo.h5" Class="mt-6 mb-2">Отзывы</MudText>
            <div class="reviews-list">
                @foreach (var review in _profile.Reviews)
                {
                    <div class="review-card" @onclick="() => GoToMovie(review.MovieId)" style="cursor: pointer">
                        <div class="review-header">
                            <span class="review-movie-id">Фильм #@review.MovieId</span>
                            @if (review.AuthorRating.HasValue)
                            {
                                <span class="review-rating">@review.AuthorRating.Value/10</span>
                            }
                            <span class="review-date">@review.CreatedAt?.ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="review-content">@review.Content</div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid UserId { get; set; }

    private UserProfileDto? _profile;
    private bool _loading = true;
    private bool _isOwnProfile;
    private bool _followLoading;
    private FollowStatusDto? _followStatus;
    private TasteComparisonDto? _comparison;
    private Guid _currentUserId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await TokenStore.LoadFromStorageAsync();
        if (!TokenStore.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var currentUser = await AuthService.GetProfileAsync();
        _currentUserId = currentUser?.Id ?? Guid.Empty;
        _isOwnProfile = _currentUserId == UserId;

        _profile = await Catalog.GetUserProfileAsync(UserId);
        if (!_isOwnProfile)
        {
            _followStatus = await Catalog.GetFollowStatusAsync(UserId);
            _comparison = await Catalog.CompareWithUserAsync(_currentUserId, UserId);
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task ToggleFollow()
    {
        _followLoading = true;
        if (_followStatus?.IsFollowing == true)
            await Catalog.UnfollowUserAsync(UserId);
        else
            await Catalog.FollowUserAsync(UserId);
        _followStatus = await Catalog.GetFollowStatusAsync(UserId);
        _followLoading = false;
    }

    private void GoToMovie(int movieId) => Navigation.NavigateTo($"/movie/{movieId}");
}

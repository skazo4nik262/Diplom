@page "/register"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center mt-16">
    <MudCard Elevated Class="pa-8" Style="width: 100%; max-width: 420px;">
        <MudCardContent>
            <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Создать аккаунт</MudText>

            <MudTextField @bind-Value="login" Label="Логин" Variant="Variant.Outlined" Class="mb-4" />
            <MudTextField @bind-Value="username" Label="Имя пользователя (необязательно)" Variant="Variant.Outlined" Class="mb-4" />
            <MudTextField @bind-Value="password" Label="Пароль" Variant="Variant.Outlined"
                         InputType="@(_showPassword ? InputType.Text : InputType.Password)" Class="mb-4"
                         Adornment="Adornment.End"
                         AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                         IconSize="Size.Small"
                         OnAdornmentClick="@(() => _showPassword = !_showPassword)" />
            <MudTextField @bind-Value="confirmPassword" Label="Подтвердите пароль" Variant="Variant.Outlined"
                         InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)" Class="mb-6"
                         Adornment="Adornment.End"
                         AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                         IconSize="Size.Small"
                         OnAdornmentClick="@(() => _showConfirmPassword = !_showConfirmPassword)" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="@isLoading" OnClick="@HandleRegister" Class="mb-4" Size="Size.Large">
                @(isLoading ? "Регистрация..." : "Зарегистрироваться")
                @if (isLoading)
                {
                    <MudProgressCircular Indeterminate Size="Size.Small" Class="ml-2" />
                }
            </MudButton>

            <MudText Align="Align.Center">
                <MudLink Href="/login">Уже есть аккаунт? Авторизируйтесь</MudLink>
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string login = "";
    private string username = "";
    private string password = "";
    private string confirmPassword = "";
    private bool isLoading;
    private bool _showPassword;
    private bool _showConfirmPassword;

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(password))
        {
            Snackbar.Add("Fill in all fields", Severity.Warning);
            return;
        }

        var passwordError = CheckPasswordStrength(password);
        if (passwordError is not null)
        {
            Snackbar.Add(passwordError, Severity.Warning);
            return;
        }

        if (password != confirmPassword)
        {
            Snackbar.Add("Passwords do not match", Severity.Warning);
            return;
        }

        isLoading = true;

        var (result, err) = await AuthService.RegisterAsync(login, password,
            string.IsNullOrWhiteSpace(username) ? null : username);

        isLoading = false;

        if (result is null)
        {
            Snackbar.Add(err ?? "Ошибка регистрации", Severity.Error);
            return;
        }

        Snackbar.Add("Аккаунт создан! Войдите.", Severity.Success);
        Navigation.NavigateTo("/login");
    }

    private static string? CheckPasswordStrength(string password)
    {
        if (password.Length < 8)
            return "Пароль должен содержать минимум 8 символов";
        if (!password.Any(char.IsUpper))
            return "Пароль должен содержать хотя бы одну заглавную букву";
        if (!password.Any(char.IsLower))
            return "Пароль должен содержать хотя бы одну строчную букву";
        if (!password.Any(char.IsDigit))
            return "Пароль должен содержать хотя бы одну цифру";
        if (!password.Any(c => !char.IsLetterOrDigit(c)))
            return "Пароль должен содержать хотя бы один спецсимвол";
        return null;
    }
}

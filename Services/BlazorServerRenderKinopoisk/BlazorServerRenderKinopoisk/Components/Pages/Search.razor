@page "/search"
@rendermode InteractiveServer
@implements IDisposable
@inject CatalogService Catalog
@inject TokenStore TokenStore
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="mt-4">
    @if (isLoading && movies.Count == 0)
    {
        <div class="d-flex justify-center mt-16">
            <MudProgressCircular Indeterminate Size="Size.Large" />
        </div>
    }
    else if (movies.Count == 0 && !isLoading)
    {
        <div class="d-flex justify-center mt-16">
            <MudText Typo="Typo.h6" Style="opacity: 0.5">No movies found</MudText>
        </div>
    }
    else
    {
        <MudText Typo="Typo.h5" Class="mb-4">Search results for "@query"</MudText>
        <div class="search-grid">
            @foreach (var movie in movies)
            {
                <div @onclick="() => GoToMovie(movie)" class="movie-card" style="cursor: pointer">
                    <div class="movie-poster" style="background-image: url('@movie.PosterUrl')">
                        <div class="movie-rating-badge@(movie.VoteAverage > 7.0 ? " high-rating" : "")">
                            @movie.RatingText
                        </div>
                    </div>
                    <div class="movie-title">@movie.Title</div>
                </div>
            }
        </div>
        @if (_hasMore)
        {
            <div class="d-flex justify-center mt-4 mb-4">
                @if (_isLoadingMore)
                {
                    <MudProgressCircular Indeterminate Size="Size.Small" />
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" @onclick="LoadMore">Load more</MudButton>
                }
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? Query { get; set; }

    private List<MovieDto> movies = [];
    private string? query;
    private bool isLoading = true;
    private int _page = 1;
    private bool _hasMore = true;
    private bool _isLoadingMore;
    private DotNetObjectReference<Search>? _dotNetRef;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await TokenStore.LoadFromStorageAsync();
        if (!TokenStore.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _initialized = true;
        await DoSearch();

        if (_hasMore && movies.Count > 0)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initInfiniteScroll", _dotNetRef);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized) return;
        if (Query != query)
            await DoSearch();
    }

    private async Task DoSearch()
    {
        query = Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            isLoading = false;
            movies = [];
            return;
        }

        _page = 1;
        _hasMore = true;
        movies = [];
        isLoading = true;
        StateHasChanged();

        await TokenStore.LoadFromStorageAsync();
        if (!TokenStore.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            movies = await Catalog.SearchAsync(query, _page);
            _hasMore = movies.Count > 0;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        isLoading = false;
    }

    private void GoToMovie(MovieDto movie)
    {
        Navigation.NavigateTo($"/movie/{movie.Id}");
    }

    [JSInvokable]
    public async Task LoadMore()
    {
        if (_isLoadingMore || !_hasMore || string.IsNullOrWhiteSpace(query)) return;
        _isLoadingMore = true;
        StateHasChanged();

        _page++;
        List<MovieDto>? newMovies;
        try { newMovies = await Catalog.SearchAsync(query, _page); }
        catch { _isLoadingMore = false; return; }

        if (newMovies.Count == 0)
            _hasMore = false;
        else
            movies.AddRange(newMovies);

        _isLoadingMore = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
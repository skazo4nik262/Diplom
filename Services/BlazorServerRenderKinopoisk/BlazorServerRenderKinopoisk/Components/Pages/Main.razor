@page "/main"
@rendermode InteractiveServer
@implements IDisposable
@inject CatalogService Catalog
@inject TokenStore TokenStore
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IJSRuntime JS

<div class="page-fade-in">
<Hero Movies="popularMovies" />

    <div class="genre-bar mt-4 mb-4">
        @foreach (var genre in CatalogService.Genres)
        {
            <button class="genre-pill" @onclick="() => GoToGenre(genre.Id)">
                @genre.Name
            </button>
        }
    </div>

    @if (trendingMovies.Count > 0)
    {
        <MudText Typo="Typo.h5" Class="mb-2 mt-4">В тренде</MudText>
        <div class="carousel-wrapper">
            <button class="carousel-arrow carousel-arrow-left" onclick="scrollCarousel(this.parentElement.querySelector('.trending-carousel'), -1)" type="button">‹</button>
            <div class="trending-carousel carousel">
                @foreach (var movie in trendingMovies)
                {
                    <MovieCard Movie="movie" UserStatus="_userStatuses.GetValueOrDefault(movie.Id)"
                               OnHover="HoverMovie" OnUnhover="UnhoverMovie" OnMouseMove="TrackMouse" />
                }
            </div>
            <button class="carousel-arrow carousel-arrow-right" onclick="scrollCarousel(this.parentElement.querySelector('.trending-carousel'), 1)" type="button">›</button>
        </div>
    }

    @if (recommendedMovies.Count > 0)
    {
        <MudText Typo="Typo.h5" Class="mb-2 mt-4">Рекомендуем вам</MudText>
        <div class="carousel-wrapper">
            <button class="carousel-arrow carousel-arrow-left" onclick="scrollCarousel(this.parentElement.querySelector('.recommended-carousel'), -1)" type="button">‹</button>
            <div class="recommended-carousel carousel">
                @foreach (var movie in recommendedMovies)
                {
                    <MovieCard Movie="movie" UserStatus="_userStatuses.GetValueOrDefault(movie.Id)"
                               OnHover="HoverMovie" OnUnhover="UnhoverMovie" OnMouseMove="TrackMouse" />
                }
            </div>
            <button class="carousel-arrow carousel-arrow-right" onclick="scrollCarousel(this.parentElement.querySelector('.recommended-carousel'), 1)" type="button">›</button>
        </div>
    }

    <MudText Typo="Typo.h5" Class="mb-2 mt-4">Популярные фильмы</MudText>
    <div class="carousel-wrapper">
        <button class="carousel-arrow carousel-arrow-left" onclick="scrollCarousel(this.parentElement.querySelector('.popular-carousel'), -1)" type="button">‹</button>
            <div class="popular-carousel carousel">
                @foreach (var movie in popularMovies)
                {
                    <MovieCard Movie="movie" UserStatus="_userStatuses.GetValueOrDefault(movie.Id)"
                               OnHover="HoverMovie" OnUnhover="UnhoverMovie" OnMouseMove="TrackMouse" />
                }
            </div>
        <button class="carousel-arrow carousel-arrow-right" onclick="scrollCarousel(this.parentElement.querySelector('.popular-carousel'), 1)" type="button">›</button>
    </div>

    <MudText Typo="Typo.h5" Class="mb-2 mt-6">Хорошо оцененные</MudText>
    <div class="carousel-wrapper">
        <button class="carousel-arrow carousel-arrow-left" onclick="scrollCarousel(this.parentElement.querySelector('.toprated-carousel'), -1)" type="button">‹</button>
            <div class="toprated-carousel carousel">
                @foreach (var movie in topRatedMovies)
                {
                    <MovieCard Movie="movie" UserStatus="_userStatuses.GetValueOrDefault(movie.Id)"
                               OnHover="HoverMovie" OnUnhover="UnhoverMovie" OnMouseMove="TrackMouse" />
                }
            </div>
        <button class="carousel-arrow carousel-arrow-right" onclick="scrollCarousel(this.parentElement.querySelector('.toprated-carousel'), 1)" type="button">›</button>
    </div>

    @if (isLoading)
    {
        <div class="carousel-wrapper mt-4">
            <div class="carousel">
                @for (var i = 0; i < 8; i++)
                {
                    <div class="skeleton-card">
                        <div class="skeleton skeleton-poster"></div>
                        <div class="skeleton skeleton-text"></div>
                        <div class="skeleton skeleton-text-short"></div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (_hoveredMovie != null)
{
    <MovieTooltip Movie="_hoveredMovie" UserStatus="_userStatuses.GetValueOrDefault(_hoveredMovie.Id)" OnMouseEnter="CancelUnhover" OnMouseLeave="ScheduleUnhover" OnStatusChanged="HandleStatusChanged" />
}

@code {
    private List<MovieDto> popularMovies = [];
    private List<MovieDto> topRatedMovies = [];
    private List<MovieDto> recommendedMovies = [];
    private List<MovieDto> trendingMovies = [];
    private bool isLoading = true;
    private Dictionary<int, UserMovieStatusDto> _userStatuses = [];

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private DateTime _tokenExpiry = DateTime.MinValue;

    private MovieDto? _hoveredMovie;
    private CancellationTokenSource? _hoverCts;
    private double _mouseX;
    private double _mouseY;

    private void GoToGenre(int genreId) => Navigation.NavigateTo($"/search?genreIds={genreId}");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await TokenStore.LoadFromStorageAsync();

        if (!TokenStore.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var popularTask = Catalog.GetPopularAsync();
            var topRatedTask = Catalog.GetTopRatedAsync();
            var recsTask = Catalog.GetRecommendationsAsync();
            var trendingTask = Catalog.GetTrendingAsync();
            await Task.WhenAll(popularTask, topRatedTask, recsTask, trendingTask);

            popularMovies = popularTask.Result;
            topRatedMovies = topRatedTask.Result;
            recommendedMovies = recsTask.Result;
            trendingMovies = trendingTask.Result;

            var allIds = popularMovies.Concat(topRatedMovies).Concat(recommendedMovies).Concat(trendingMovies)
                .Select(m => m.Id).Distinct().ToList();
            _userStatuses = await Catalog.GetUserMoviesStatusBatchAsync(allIds);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        isLoading = false;
        StateHasChanged();

        StartSessionMonitor();
    }

    private void StartSessionMonitor()
    {
        var expiry = TokenStore.GetTokenExpiry();
        if (expiry == null) return;

        _tokenExpiry = expiry.Value;
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        _ = MonitorSessionAsync(_cts.Token);
    }

    private async Task MonitorSessionAsync(CancellationToken ct)
    {
        while (await _timer!.WaitForNextTickAsync(ct))
        {
            if (_tokenExpiry == DateTime.MinValue) break;

            var remaining = _tokenExpiry - DateTime.UtcNow;
            if (remaining <= TimeSpan.FromSeconds(60))
            {
                await InvokeAsync(async () =>
                {
                    var dialog = await DialogService.ShowAsync<SessionExpiringDialog>();
                    await dialog.Result;
                    Navigation.NavigateTo("/login");
                });
                break;
            }
        }
    }

    private void HoverMovie(MovieDto movie)
    {
        if (_hoveredMovie != null)
        {
            _hoverCts?.Cancel();
            _hoveredMovie = movie;
            _ = JS.InvokeVoidAsync("setTooltipPos", _mouseX, _mouseY);
            StateHasChanged();
            return;
        }

        _hoverCts?.Cancel();
        _hoverCts = new CancellationTokenSource();
        var cts = _hoverCts;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(200, cts.Token);
                await InvokeAsync(() =>
                {
                    if (cts.IsCancellationRequested) return;
                    if (_hoveredMovie == movie) return;
                    _hoveredMovie = movie;
                    _ = JS.InvokeVoidAsync("setTooltipPos", _mouseX, _mouseY);
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private void TrackMouse(MouseEventArgs e)
    {
        _mouseX = e.ClientX;
        _mouseY = e.ClientY;
    }

    private void UnhoverMovie()
    {
        _hoverCts?.Cancel();
        if (_hoveredMovie != null)
            ScheduleUnhover();
    }

    private void ScheduleUnhover()
    {
        if (_hoveredMovie == null) return;

        _hoverCts?.Cancel();
        _hoverCts = new CancellationTokenSource();
        var cts = _hoverCts;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(200, cts.Token);
                await InvokeAsync(() =>
                {
                    _hoveredMovie = null;
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private void CancelUnhover()
    {
        _hoverCts?.Cancel();
    }

    private void HandleStatusChanged((int MovieId, UserMovieStatusDto? Status) data)
    {
        if (data.Status is null)
            _userStatuses.Remove(data.MovieId);
        else
            _userStatuses[data.MovieId] = data.Status;
        StateHasChanged();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
        _hoverCts?.Cancel();
        _hoverCts?.Dispose();
    }
}

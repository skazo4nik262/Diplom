@page "/main"
@rendermode InteractiveServer
@implements IDisposable
@inject CatalogService Catalog
@inject TokenStore TokenStore
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IJSRuntime JS

<MudContainer Class="mt-4">
    <Hero Movies="popularMovies" />

    <MudText Typo="Typo.h5" Class="mb-2 mt-4">Popular Movies</MudText>
    <div class="carousel">
        @foreach (var movie in popularMovies)
        {
            <div @onmouseenter="(e) => HoverMovie(movie, e)" @onmouseleave="ScheduleUnhover" @onmousemove="(e) => TrackMouseMove(e)" class="movie-card">
                <div class="movie-poster" style="background-image: url('@movie.PosterUrl')">
                    <div class="movie-rating-badge@(movie.VoteAverage > 7.0 ? " high-rating" : "")">
                        @movie.RatingText
                    </div>
                </div>
                <div class="movie-title">@movie.Title</div>
            </div>
        }
    </div>

    <MudText Typo="Typo.h5" Class="mb-2 mt-6">Top Rated</MudText>
    <div class="carousel">
        @foreach (var movie in topRatedMovies)
        {
            <div @onmouseenter="(e) => HoverMovie(movie, e)" @onmouseleave="ScheduleUnhover" @onmousemove="(e) => TrackMouseMove(e)" class="movie-card">
                <div class="movie-poster" style="background-image: url('@movie.PosterUrl')">
                    <div class="movie-rating-badge@(movie.VoteAverage > 7.0 ? " high-rating" : "")">
                        @movie.RatingText
                    </div>
                </div>
                <div class="movie-title">@movie.Title</div>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-center mt-16">
            <MudProgressCircular Indeterminate Size="Size.Large" />
        </div>
    }
</MudContainer>

@if (_hoveredMovie != null)
{
    <MovieTooltip Movie="_hoveredMovie" OnMouseEnter="CancelUnhover" OnMouseLeave="ScheduleUnhover" />
}

@code {
    private List<MovieDto> popularMovies = [];
    private List<MovieDto> topRatedMovies = [];
    private bool isLoading = true;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private DateTime _tokenExpiry = DateTime.MinValue;

    private MovieDto? _hoveredMovie;
    private CancellationTokenSource? _hoverCts;
    private double _mouseX;
    private double _mouseY;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await TokenStore.LoadFromStorageAsync();

        if (!TokenStore.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var popularTask = Catalog.GetPopularAsync();
            var topRatedTask = Catalog.GetTopRatedAsync();
            await Task.WhenAll(popularTask, topRatedTask);

            popularMovies = popularTask.Result;
            topRatedMovies = topRatedTask.Result;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        isLoading = false;
        StateHasChanged();

        StartSessionMonitor();
    }

    private void StartSessionMonitor()
    {
        var expiry = TokenStore.GetTokenExpiry();
        if (expiry == null) return;

        _tokenExpiry = expiry.Value;
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        _ = MonitorSessionAsync(_cts.Token);
    }

    private async Task MonitorSessionAsync(CancellationToken ct)
    {
        while (await _timer!.WaitForNextTickAsync(ct))
        {
            if (_tokenExpiry == DateTime.MinValue) break;

            var remaining = _tokenExpiry - DateTime.UtcNow;
            if (remaining <= TimeSpan.FromSeconds(60))
            {
                await InvokeAsync(async () =>
                {
                    var dialog = await DialogService.ShowAsync<SessionExpiringDialog>();
                    await dialog.Result;
                    Navigation.NavigateTo("/login");
                });
                break;
            }
        }
    }

    private void HoverMovie(MovieDto movie, MouseEventArgs e)
    {
        _mouseX = e.ClientX;
        _mouseY = e.ClientY;

        if (_hoveredMovie != null)
        {
            _hoverCts?.Cancel();
            _hoveredMovie = movie;
            _ = JS.InvokeVoidAsync("setTooltipPos", _mouseX, _mouseY);
            StateHasChanged();
            return;
        }

        _hoverCts?.Cancel();
        _hoverCts = new CancellationTokenSource();
        var cts = _hoverCts;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(200, cts.Token);
                await InvokeAsync(() =>
                {
                    _hoveredMovie = movie;
                    _ = JS.InvokeVoidAsync("setTooltipPos", _mouseX, _mouseY);
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private void TrackMouseMove(MouseEventArgs e)
    {
        _mouseX = e.ClientX;
        _mouseY = e.ClientY;
    }

    private void ScheduleUnhover()
    {
        if (_hoveredMovie == null)
        {
            _hoverCts?.Cancel();
            return;
        }

        _hoverCts?.Cancel();
        _hoverCts = new CancellationTokenSource();
        var cts = _hoverCts;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(200, cts.Token);
                await InvokeAsync(() =>
                {
                    _hoveredMovie = null;
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private void CancelUnhover()
    {
        _hoverCts?.Cancel();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
        _hoverCts?.Cancel();
        _hoverCts?.Dispose();
    }
}

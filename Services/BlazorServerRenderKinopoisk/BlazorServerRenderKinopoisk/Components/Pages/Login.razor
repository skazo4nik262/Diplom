@page "/login"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject TokenStore TokenStore
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center mt-16">
    <MudCard Elevated Class="pa-8" Style="width: 100%; max-width: 420px;">
        <MudCardContent>
            <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8">Вход</MudText>

            <MudTextField @bind-Value="login" Label="Логин" Variant="Variant.Outlined" Class="mb-4" />
            <MudTextField @bind-Value="password" Label="Пароль" Variant="Variant.Outlined"
                         InputType="@(_showPassword ? InputType.Text : InputType.Password)" Class="mb-6"
                         Adornment="Adornment.End"
                         AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                         IconSize="Size.Small"
                         OnAdornmentClick="@(() => _showPassword = !_showPassword)" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="@isLoading" OnClick="@HandleLogin" Class="mb-4" Size="Size.Large">
                @(isLoading ? "Вход..." : "Войти")
                @if (isLoading)
                {
                    <MudProgressCircular Indeterminate Size="Size.Small" Class="ml-2" />
                }
            </MudButton>

            <MudText Align="Align.Center">
                <MudLink Href="/register">Нет аккаунта? Зарегистрироваться</MudLink>
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string login = "";
    private string password = "";
    private bool isLoading;
    private bool _showPassword;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(password))
        {
            Snackbar.Add("Заполните все поля", Severity.Warning);
            return;
        }

        isLoading = true;

        var (result, err) = await AuthService.LoginAsync(login, password);

        isLoading = false;

        if (result is null)
        {
            Snackbar.Add(err ?? "Ошибка входа", Severity.Error);
            return;
        }

        await TokenStore.SaveAsync(result.Token, result.RefreshToken);
        Navigation.NavigateTo("/main");
    }
}

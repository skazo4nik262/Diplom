<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Сессия истекает</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Ваша сессия скоро истечёт. Нажмите OK, чтобы войти снова.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Close() => MudDialog.Close();
}

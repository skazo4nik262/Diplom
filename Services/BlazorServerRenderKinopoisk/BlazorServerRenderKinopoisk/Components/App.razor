<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
    <link rel="stylesheet" href="@Assets["BlazorServerRenderKinopoisk.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="https://cdn.plyr.io/3.7.8/plyr.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script>
        window._tooltipPos = { x: 0, y: 0 };

        window.setTooltipPos = function(x, y) {
            window._tooltipPos = { x: x, y: y };
        };

        window.positionTooltip = function() {
            var el = document.getElementById('movie-tooltip');
            if (!el) return;
            var poster = el.getAttribute('data-poster');
            if (poster) el.style.backgroundImage = 'url(' + poster + ')';
            var x = window._tooltipPos.x, y = window._tooltipPos.y;
            var w = el.offsetWidth, h = el.offsetHeight;
            var pad = 20;
            var left = x + pad, top = y + pad;
            if (left + w > window.innerWidth - 10) left = window.innerWidth - w - 10;
            if (top + h > window.innerHeight - 10) top = window.innerHeight - h - 10;
            if (left < 0) left = 10;
            if (top < 0) top = 10;
            el.style.left = left + 'px';
            el.style.top = top + 'px';
        };
        window.scrollCarousel = function(el, dir) {
            var card = el.querySelector('.movie-card');
            var step = (card ? card.offsetWidth + 12 : 162) * 4;
            el.scrollBy({ left: dir * step, behavior: 'smooth' });
        };

        window.scrollCastCarousel = function(el, dir) {
            var card = el.querySelector('.cast-card');
            var step = (card ? card.offsetWidth + 12 : 140) * 4;
            el.scrollBy({ left: dir * step, behavior: 'smooth' });
        };

        window.getHeroCardStep = function(el) {
            var card = el.querySelector('.hero-card');
            return card ? card.offsetWidth + 36 : 486;
        };

        window.scrollHeroTo = function(el, left) {
            el.scrollTo({ left: left, behavior: 'smooth' });
        };

        window.initInfiniteScroll = function(dotnetHelper) {
            var ticking = false;
            function onScroll() {
                if (!ticking) {
                    window.requestAnimationFrame(function() {
                        var scrollBottom = window.innerHeight + window.scrollY;
                        var threshold = document.documentElement.scrollHeight - 500;
                        if (scrollBottom >= threshold) {
                            dotnetHelper.invokeMethodAsync('LoadMore');
                        }
                        ticking = false;
                    });
                    ticking = true;
                }
            }
            window.addEventListener('scroll', onScroll);
        };

        window._playerPosition = 0;
        window._playerDuration = 0;
        window._initialPosition = null;

        window.initMoviePlayer = function() {
            var el = document.getElementById('movie-player');
            if (!el || el.plyr) return;
            var src = el.getAttribute('data-hls-src');
            if (src && Hls.isSupported()) {
                var hls = new Hls();
                hls.loadSource(src);
                hls.attachMedia(el);
                el.addEventListener('loadedmetadata', function() {
                    var player = new Plyr(el);
                    player.on('timeupdate', function() {
                        window._playerPosition = player.currentTime;
                        window._playerDuration = player.duration;
                    });
                    if (window._initialPosition > 0) {
                        player.on('ready', function() {
                            player.currentTime = window._initialPosition;
                            window._initialPosition = null;
                        });
                    }
                });
            } else {
                var player = new Plyr(el);
                player.on('timeupdate', function() {
                    window._playerPosition = player.currentTime;
                    window._playerDuration = player.duration;
                });
                if (window._initialPosition > 0) {
                    player.on('ready', function() {
                        player.currentTime = window._initialPosition;
                        window._initialPosition = null;
                    });
                }
            }
        };

        window.setInitialPosition = function(pos) {
            window._initialPosition = pos;
            var el = document.getElementById('movie-player');
            if (el && el.plyr) {
                el.plyr.currentTime = pos;
            }
        };

        window.getPlayerState = function() {
            return { Position: window._playerPosition, Duration: window._playerDuration };
        };

        window.showToast = function(message) {
            var container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                document.body.appendChild(container);
            }
            var toast = document.createElement('div');
            toast.className = 'toast-notification';
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() { toast.remove(); }, 2500);
        };

        window.copyToClipboard = function(text) {
            navigator.clipboard.writeText(text).then(function() {
                window.showToast('Ссылка скопирована');
            });
        };

    </script>
</body>

</html>
